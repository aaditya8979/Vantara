# ─── VANTARA Environment Variables ───
# Copy this file to .env and fill in values as needed.

# Frontend (Vite)
# Override API base URL for local development (default: /api)
# VITE_API_BASE=http://localhost:8000

# Backend (FastAPI)
# No environment variables required for basic operation.
# The synthetic data engine generates all data deterministically.

# Optional: Google Gemini API Key (for AI-powered summaries)
# GOOGLE_API_KEY=your-api-key-here
